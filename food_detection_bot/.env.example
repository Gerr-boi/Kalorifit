PROVIDER=yolo
ENSEMBLE_PROVIDERS=yolo,max_remote
ENSEMBLE_DEDUP_IOU=0.55
MODEL_ID=yolo11n.pt
MAX_REMOTE_BASE_URL=http://127.0.0.1:5000
MAX_REMOTE_PREDICT_PATH=/model/predict
MAX_REMOTE_TIMEOUT_MS=12000
MAX_REMOTE_THRESHOLD=0.35
CONF_THRESHOLD=0.35
TOP_K=5
TEXT_DETECTION_ENABLED=true
TEXT_PROVIDER=paddleocr
TEXT_CONF_THRESHOLD=0.0
PACKAGE_CLASS_NAME=package
FALLBACK_CROP_MAX_AREA_RATIO=0.9
FALLBACK_CROP_MIN_CONFIDENCE=0.15
FALLBACK_CROP_PREFERRED_LABELS=
PRODUCT_CATALOG_PATH=src/data/products.json
ENABLE_SCAN_LOGGING=true
ENABLE_PACKAGE_CROP_LOGGING=true
DATASET_DIR=dataset
MAX_IMAGE_BYTES=8388608
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# Set to a strong random secret (e.g. openssl rand -hex 32).
# Leave empty to disable API key auth (dev only — never leave empty in prod).
BOT_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Leave empty to skip Supabase logging (file-based logging is always active).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
